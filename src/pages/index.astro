      <img
        src="/screenshot.png"
        alt={screenshotAlt}
        class="screenshot"
      />
      <a href="/app" class="cta">評価してみる</a>
    </main>
    <footer>
      <a href={doujinUrl} target="_blank" rel="noopener noreferrer"
        >評価の理論的背景が気になる方へ</a
      ><br />
      <span>配信・動画での利用はご自由にどうぞ</span><br />
