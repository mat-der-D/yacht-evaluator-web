---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content="ヨット（ポーカーに似たダイスゲーム）の局面評価ツール。期待値の数学理論に基づいた手の評価を瞬時に確認できます。" />
    <meta name="author" content="Smooth Pudding" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#3b82f6" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://yacht-evaluator.smooth-pudding.net/app" />
    <meta property="og:site_name" content="Yacht Evaluator" />
    <meta property="og:title" content="ヨット局面評価 for アソビ大全" />
    <meta property="og:description" content="ヨット（ポーカーに似たダイスゲーム）の局面評価ツール。期待値の数学理論に基づいた手の評価を瞬時に確認できます。" />
    <meta property="og:image" content="https://yacht-evaluator.smooth-pudding.net/screenshot.png" />
    <meta property="og:image:width" content="1006" />
    <meta property="og:image:height" content="901" />
    <meta property="og:image:alt" content="ヨット局面評価ツールのスクリーンショット" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ヨット局面評価 for アソビ大全" />
    <meta name="twitter:description" content="ヨット（ポーカーに似たダイスゲーム）の局面評価ツール。期待値の数学理論に基づいた手の評価を瞬時に確認できます。" />
    <meta name="twitter:image" content="https://yacht-evaluator.smooth-pudding.net/screenshot.png" />
    <meta name="twitter:image:alt" content="ヨット局面評価ツールのスクリーンショット" />

    <link rel="manifest" href="/app/manifest.webmanifest" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      "Roboto",
      "Oxygen",
      "Ubuntu",
      "Cantarell",
      "Fira Sans",
      "Droid Sans",
      "Helvetica Neue",
      sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
</style>
